# PyInstaller version resource for FleetX_Toolkit.exe.
# Embeds product/company/version metadata so the exe is not an anonymous
# unsigned binary — the #1 trigger for Defender's Sabsik !ml false positive.
# {VER_TUPLE} and {VER_STR} are filled in by the build step from APP_VERSION.
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers={VER_TUPLE},
    prodvers={VER_TUPLE},
    mask=0x3f,
    flags=0x0,
    OS=0x40004,
    fileType=0x1,
    subtype=0x0,
    date=(0, 0)
  ),
  kids=[
    StringFileInfo([
      StringTable(
        '040904B0',
        [StringStruct('CompanyName', 'Fleetx Technologies Pvt. Ltd.'),
         StringStruct('FileDescription', 'FleetX Toolkit — internal fleet operations utility'),
         StringStruct('FileVersion', '{VER_STR}'),
         StringStruct('InternalName', 'FleetX_Toolkit'),
         StringStruct('LegalCopyright', 'Copyright (c) Fleetx Technologies Pvt. Ltd.'),
         StringStruct('OriginalFilename', 'FleetX_Toolkit.exe'),
         StringStruct('ProductName', 'FleetX Toolkit'),
         StringStruct('ProductVersion', '{VER_STR}')])
    ]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
